{
    "branches": [
      {"name": "main"},
      {"name": "alpha", "channel":"alpha" , "prerelease": "alpha" },
      {"name": "beta", "channel":"beta" , "prerelease": "beta" },
      {"name": "rc", "channel":"rc" , "prerelease": "rc" }
    ],
    "tagFormat": "v${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "verifyReleaseCmd": "echo ${nextRelease.version} > backend/VERSION && npx json -I -f frontend/package.json -e \"this.version='${nextRelease.version}'\"",
          "prepareCmd": "echo Prepared release ${nextRelease.version} && sed -i 's#https://forge\\.lan\\.danielleandjohn\\.love/lenore/LenoreFin#https://github.com/Novanglus96/LenoreFin#g' CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "frontend/package.json",
            "backend/VERSION"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@saithodev/semantic-release-gitea"
    ]
  }
  